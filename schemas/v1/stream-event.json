{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One line of `--json-stream` output before the final envelope.",
  "oneOf": [
    {
      "properties": {
        "done": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "type": {
          "const": "progress",
          "type": "string"
        }
      },
      "required": [
        "type",
        "phase",
        "done"
      ],
      "type": "object"
    }
  ],
  "title": "StreamEvent"
}
